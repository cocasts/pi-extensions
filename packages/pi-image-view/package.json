{
  "name": "@cocasts/pi-image-view",
  "version": "0.1.1",
  "description": "Paste screenshots into pi without file paths — [🖼 #N] icon markers, uniform-size draft previews, clickable history, and compact model thumbnails",
  "author": "moecasts <moecasts.caster@gmail.com>",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "pi",
    "image",
    "screenshot",
    "clipboard",
    "paste",
    "preview",
    "thumbnail"
  ],
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "src/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "vitest": "^4.1.9"
  }
}
